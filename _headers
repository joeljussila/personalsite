# Cloudflare Pages response headers, kept in step with vercel.json only until
# the domain is served by Vercel. Delete this file after the cutover.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # The site is self-contained apart from Google Fonts. Nothing is inline any
  # more - the styles live in site.css and the globe in globe.js - so the
  # policy can refuse inline script and style outright.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

/places/photos/*
  Cache-Control: public, max-age=31536000, immutable
